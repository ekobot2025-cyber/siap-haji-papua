// PRODUCTION POSTGRESQL SCHEMA FOR SIAP HAJI PAPUA (PHASE 1 + PHASE 2)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique @map("setting_key")
  settingValue String   @map("setting_value")
  settingGroup String   @default("GENERAL") @map("setting_group")
  description  String?
  isPublic     Boolean  @default(false) @map("is_public")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")

  @@map("system_settings")
}

model Region {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      String   @default("KABUPATEN")
  parentId  String?  @map("parent_id")
  parent    Region?  @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Region[] @relation("RegionHierarchy")
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  jamaah        Jamaah[]
  manasikEvents ManasikEvent[]
  warningEvents WarningEvent[]

  @@index([code])
  @@map("regions")
}

model HajjSeason {
  id                 String    @id @default(uuid())
  yearHijri          Int       @map("year_hijri")
  yearGregorian      Int       @map("year_gregorian")
  seasonName         String    @map("season_name")
  quotaTotal         Int       @default(0) @map("quota_total")
  quotaRegular       Int       @default(0) @map("quota_regular")
  quotaReserved      Int       @default(0) @map("quota_reserved")
  departureStartDate DateTime? @map("departure_start_date")
  returnEndDate      DateTime? @map("return_end_date")
  isActive           Boolean   @default(false) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  jamaah          Jamaah[]
  readinessRules  ReadinessRule[]
  readinessScores ReadinessScore[]
  manasikEvents   ManasikEvent[]
  kloter          Kloter[]
  officers        Officer[]

  @@map("hajj_seasons")
}

model User {
  id                  String    @id @default(uuid())
  username            String    @unique
  email               String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String    @map("full_name")
  phoneNumber         String?   @map("phone_number")
  regionId            String?   @map("region_id")
  region              Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  avatarUrl           String?   @map("avatar_url")
  isActive            Boolean   @default(true) @map("is_active")
  isMfaEnabled        Boolean   @default(false) @map("is_mfa_enabled")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  roles                 UserRole[]
  jamaah                Jamaah?
  auditLogs             AuditLog[]
  documentVerifications DocumentVerification[]
  adminVerifications    AdministrationRecord[]
  manasikVerifications  ManasikAttendance[]
  resolvedWarnings      WarningEvent[]
  assignedTasks         ActionItem[] @relation("ActionAssignedTo")
  delegatedTasks        ActionItem[] @relation("ActionAssignedBy")
  officerRecord         Officer?

  @@index([regionId])
  @@index([username])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  isSystemRole Boolean  @default(true) @map("is_system_role")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Jamaah {
  id                     String      @id @default(uuid())
  userId                 String?     @unique @map("user_id")
  user                   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  seasonId               String      @map("season_id")
  season                 HajjSeason  @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  regionId               String      @map("region_id")
  region                 Region      @relation(fields: [regionId], references: [id], onDelete: Restrict)
  porsiNumber            String      @unique @map("porsi_number")
  nikEncrypted           String      @map("nik_encrypted")
  nikHash                String      @map("nik_hash")
  kkNumberEncrypted      String?     @map("kk_number_encrypted")
  fullName               String      @map("full_name")
  birthPlace             String      @map("birth_place")
  birthDate              DateTime    @map("birth_date")
  gender                 String
  maritalStatus          String      @default("MARRIED") @map("marital_status")
  address                String
  district               String?
  subDistrict            String?     @map("sub_district")
  postalCode             String?     @map("postal_code")
  phoneEncrypted         String?     @map("phone_encrypted")
  bloodType              String?     @map("blood_type")
  occupation             String?
  registrationYear       Int         @map("registration_year")
  estimatedDepartureYear Int?        @map("estimated_departure_year")
  status                 String      @default("TERDAFTAR")
  dataSource             String      @default("DEMO") @map("data_source")
  isPriorityElderly      Boolean     @default(false) @map("is_priority_elderly")
  elderlyAge             Int?        @map("elderly_age")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  deletedAt              DateTime?   @map("deleted_at")

  readinessScore        ReadinessScore?
  documents             JamaahDocument[]
  administrationRecords AdministrationRecord[]
  healthRecords         HealthMonitoring[]
  manasikAttendances    ManasikAttendance[]
  kloterMembership      KloterMember?
  warningEvents         WarningEvent[]
  actionItems           ActionItem[]

  @@index([seasonId, regionId])
  @@index([porsiNumber])
  @@index([nikHash])
  @@index([status])
  @@map("jamaah")
}

model DocumentType {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  isRequired        Boolean  @default(true) @map("is_required")
  maxFileSizeMb     Int      @default(5) @map("max_file_size_mb")
  allowedExtensions String   @default("pdf,jpg,jpeg,png") @map("allowed_extensions")
  sortOrder         Int      @default(0) @map("sort_order")

  documents JamaahDocument[]

  @@map("document_types")
}

model JamaahDocument {
  id              String       @id @default(uuid())
  jamaahId        String       @map("jamaah_id")
  jamaah          Jamaah       @relation(fields: [jamaahId], references: [id], onDelete: Cascade)
  documentTypeId  String       @map("document_type_id")
  documentType    DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  filePath        String?      @map("file_path")
  fileSizeBytes   Int?         @map("file_size_bytes")
  mimeType        String?      @map("mime_type")
  documentNumber  String?      @map("document_number")
  issuedDate      DateTime?    @map("issued_date")
  expiryDate      DateTime?    @map("expiry_date")
  status          String       @default("BELUM_ADA")
  rejectionReason String?      @map("rejection_reason")
  notes           String?
  dataSource      String       @default("INTERNAL") @map("data_source")
  uploadedAt      DateTime?    @map("uploaded_at")
  uploadedBy      String?      @map("uploaded_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  verifications DocumentVerification[]

  @@unique([jamaahId, documentTypeId])
  @@index([status])
  @@map("jamaah_documents")
}

model DocumentVerification {
  id               String         @id @default(uuid())
  jamaahDocumentId String         @map("jamaah_document_id")
  jamaahDocument   JamaahDocument @relation(fields: [jamaahDocumentId], references: [id], onDelete: Cascade)
  action           String
  notes            String?
  verifiedById     String         @map("verified_by_id")
  verifiedBy       User           @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("document_verifications")
}

model AdministrationRecord {
  id               String     @id @default(uuid())
  jamaahId         String     @map("jamaah_id")
  jamaah           Jamaah     @relation(fields: [jamaahId], references: [id], onDelete: Cascade)
  stageName        String     @map("stage_name")
  amountPaid       Float      @default(0.0) @map("amount_paid")
  paymentReference String?    @map("payment_reference")
  status           String     @default("BELUM")
  completionDate   DateTime?  @map("completion_date")
  notes            String?
  dataSource       String     @default("INTERNAL") @map("data_source")
  verifiedById     String?    @map("verified_by_id")
  verifiedBy       User?      @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([jamaahId, stageName])
  @@index([status])
  @@map("administration_records")
}

model HealthMonitoring {
  id                   String    @id @default(uuid())
  jamaahId             String    @map("jamaah_id")
  jamaah               Jamaah    @relation(fields: [jamaahId], references: [id], onDelete: Cascade)
  checkupStage         String    @map("checkup_stage")
  examinationDate      DateTime? @map("examination_date")
  locationName         String?   @map("location_name")
  istithaahStatus      String    @default("BELUM_PEMERIKSAAN") @map("istithaah_status")
  isVaccineMeningitis  Boolean   @default(false) @map("is_vaccine_meningitis")
  isVaccinePolio       Boolean   @default(false) @map("is_vaccine_polio")
  isVaccineCovid       Boolean   @default(false) @map("is_vaccine_covid")
  administrativeStatus String    @default("BELUM") @map("administrative_status")
  notesNonMedical      String?   @map("notes_non_medical")
  dataSource           String    @default("INTERNAL") @map("data_source")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([jamaahId, checkupStage])
  @@index([administrativeStatus])
  @@map("health_monitoring")
}

model ManasikEvent {
  id               String     @id @default(uuid())
  seasonId         String     @map("season_id")
  season           HajjSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  regionId         String     @map("region_id")
  region           Region     @relation(fields: [regionId], references: [id], onDelete: Restrict)
  title            String
  sessionNumber    Int        @default(1) @map("session_number")
  eventDate        DateTime   @map("event_date")
  startTime        String     @map("start_time")
  endTime          String     @map("end_time")
  location         String
  speakerName      String?    @map("speaker_name")
  topicDescription String?    @map("topic_description")
  qrSecretToken    String     @default(uuid()) @map("qr_secret_token")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  attendances ManasikAttendance[]

  @@index([seasonId, regionId])
  @@map("manasik_events")
}

model ManasikAttendance {
  id               String       @id @default(uuid())
  eventId          String       @map("event_id")
  event            ManasikEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  jamaahId         String       @map("jamaah_id")
  jamaah           Jamaah       @relation(fields: [jamaahId], references: [id], onDelete: Cascade)
  status           String       @default("HADIR")
  checkInTime      DateTime     @default(now()) @map("check_in_time")
  attendanceMethod String       @default("QR_SCAN") @map("attendance_method")
  verifiedById     String?      @map("verified_by_id")
  verifiedBy       User?        @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([eventId, jamaahId])
  @@index([status])
  @@map("manasik_attendance")
}

model Kloter {
  id                  String     @id @default(uuid())
  seasonId            String     @map("season_id")
  season              HajjSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  kloterNumber        Int        @map("kloter_number")
  kloterCode          String     @unique @map("kloter_code")
  embarkationName     String     @default("Embarkasi Hasanuddin Makassar (UPG)") @map("embarkation_name")
  dormitoryInDate     DateTime?  @map("dormitory_in_date")
  flightDepartureDate DateTime?  @map("flight_departure_date")
  flightReturnDate    DateTime?  @map("flight_return_date")
  airlineName         String?    @map("airline_name")
  flightNumber        String?    @map("flight_number")
  capacityTotal       Int        @default(360) @map("capacity_total")
  status              String     @default("SIAP")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  groups   Group[]
  members  KloterMember[]
  officers Officer[]

  @@index([seasonId])
  @@map("kloter")
}

model Group {
  id             String   @id @default(uuid())
  kloterId       String   @map("kloter_id")
  kloter         Kloter   @relation(fields: [kloterId], references: [id], onDelete: Cascade)
  groupType      String   @map("group_type")
  groupNumber    Int      @map("group_number")
  name           String
  leaderJamaahId String?  @map("leader_jamaah_id")

  members KloterMember[]

  @@map("groups")
}

model KloterMember {
  id         String   @id @default(uuid())
  kloterId   String   @map("kloter_id")
  kloter     Kloter   @relation(fields: [kloterId], references: [id], onDelete: Restrict)
  groupId    String?  @map("group_id")
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  jamaahId   String   @unique @map("jamaah_id")
  jamaah     Jamaah   @relation(fields: [jamaahId], references: [id], onDelete: Restrict)
  seatNumber String?  @map("seat_number")
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@index([kloterId])
  @@map("kloter_members")
}

model Officer {
  id             String     @id @default(uuid())
  seasonId       String     @map("season_id")
  season         HajjSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  kloterId       String?    @map("kloter_id")
  kloter         Kloter?    @relation(fields: [kloterId], references: [id], onDelete: SetNull)
  userId         String?    @unique @map("user_id")
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String     @map("full_name")
  roleType       String     @map("role_type")
  phoneEncrypted String     @map("phone_encrypted")
  status         String     @default("ACTIVE")

  @@map("officers")
}

model ReadinessRule {
  id               String     @id @default(uuid())
  seasonId         String     @map("season_id")
  season           HajjSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  componentCode    String     @map("component_code")
  name             String
  weightPercentage Float      @map("weight_percentage")
  evaluationLogic  String     @map("evaluation_logic")
  isActive         Boolean    @default(true) @map("is_active")
  sortOrder        Int        @default(0) @map("sort_order")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([seasonId, componentCode])
  @@map("readiness_rules")
}

model ReadinessScore {
  id                 String     @id @default(uuid())
  jamaahId           String     @unique @map("jamaah_id")
  jamaah             Jamaah     @relation(fields: [jamaahId], references: [id], onDelete: Cascade)
  seasonId           String     @map("season_id")
  season             HajjSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  totalScore         Float      @default(0.0) @map("total_score")
  category           String     @default("PRIORITAS")
  componentBreakdown String     @map("component_breakdown")
  lastCalculatedAt   DateTime   @default(now()) @map("last_calculated_at")

  @@index([totalScore])
  @@index([category])
  @@index([seasonId])
  @@map("readiness_scores")
}

model WarningRule {
  id                  String   @id @default(uuid())
  ruleCode            String   @unique @map("rule_code")
  name                String
  severity            String
  conditionExpression String   @map("condition_expression")
  description         String?
  isActive            Boolean  @default(true) @map("is_active")

  events WarningEvent[]

  @@map("warning_rules")
}

model WarningEvent {
  id              String      @id @default(uuid())
  ruleId          String      @map("rule_id")
  rule            WarningRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  jamaahId        String      @map("jamaah_id")
  jamaah          Jamaah      @relation(fields: [jamaahId], references: [id], onDelete: Cascade)
  regionId        String      @map("region_id")
  region          Region      @relation(fields: [regionId], references: [id], onDelete: Restrict)
  severity        String
  title           String
  reason          String
  status          String      @default("OPEN")
  detectedAt      DateTime    @default(now()) @map("detected_at")
  resolvedAt      DateTime?   @map("resolved_at")
  resolvedById    String?     @map("resolved_by_id")
  resolvedBy      User?       @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes String?     @map("resolution_notes")

  actionItems ActionItem[]

  @@index([status, severity])
  @@index([jamaahId])
  @@index([regionId])
  @@map("warning_events")
}

model ActionItem {
  id               String        @id @default(uuid())
  warningEventId   String?       @map("warning_event_id")
  warningEvent     WarningEvent? @relation(fields: [warningEventId], references: [id], onDelete: SetNull)
  jamaahId         String        @map("jamaah_id")
  jamaah           Jamaah        @relation(fields: [jamaahId], references: [id], onDelete: Cascade)
  category         String
  title            String
  description      String?
  assignedToUserId String?       @map("assigned_to_user_id")
  assignedTo       User?         @relation("ActionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedByUserId String?       @map("assigned_by_user_id")
  assignedBy       User?         @relation("ActionAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  deadline         DateTime?
  status           String        @default("OPEN")
  priority         String        @default("HIGH")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  resolvedAt       DateTime?     @map("resolved_at")

  @@index([status])
  @@index([category])
  @@index([assignedToUserId])
  @@index([jamaahId])
  @@map("action_items")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actorUsername String?  @map("actor_username")
  actorRole     String?  @map("actor_role")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  action        String
  module        String
  recordId      String?  @map("record_id")
  beforeState   String?  @map("before_state")
  afterState    String?  @map("after_state")
  dataSource    String   @default("INTERNAL") @map("data_source")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}
