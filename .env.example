# DATABASE CONFIGURATION
# For local zero-config development: file:./dev.db
# For PostgreSQL 16+ production: postgresql://username:password@localhost:5432/siap_haji_papua?schema=public
DATABASE_URL="file:./dev.db"

# APPLICATION & SECURITY SECRETS
# 32+ character secret for JWT signing
APP_SECRET="siap-haji-papua-super-secure-production-ready-jwt-secret-key-2026"

# 32-byte hex encryption key for AES-256-GCM field encryption (must be 64 hex characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Salt for deterministic HMAC-SHA256 blind indexing of sensitive searchable fields (e.g. NIK)
BLIND_INDEX_SALT="siap-haji-papua-blind-index-salt-2026-secure"

# ENVIRONMENT & DEMO FLAGS
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="SIAP HAJI PAPUA"
NEXT_PUBLIC_DEMO_MODE="true"
